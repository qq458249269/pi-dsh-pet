{
  "name": "pi-dsh-pet",
  "version": "0.0.2",
"description": "Standalone desktop pet (transparent Electron window) that exposes a local HTTP/WS port so pi, dsh, opencode, or any script can drive it. Ships pi / dsh / opencode adapters as thin clients.",
  "keywords": [
    "pi",
    "pi-plugin",
    "pi-extension",
    "pi-package",
    "dsh",
    "opencode",
    "opencode-plugin",
    "desktop-pet",
    "pet",
    "electron",
    "floating-widget",
    "localhost-server",
    "websocket"
  ],
  "homepage": "https://github.com/qq458249269/pi-dsh-pet#readme",
  "author": {
    "name": "yinxuehao",
    "url": "https://github.com/qq458249269"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qq458249269/pi-dsh-pet.git"
  },
  "bugs": {
    "url": "https://github.com/qq458249269/pi-dsh-pet/issues"
  },
  "type": "module",
  "main": "app/electron.cjs",
  "bin": {
    "pi-pet": "bin/pi-pet.cjs",
    "dsh-pet": "bin/pi-pet.cjs"
  },
  "files": [
    "app",
    "bin",
"pi",
    "dsh",
    "opencode",
    "assets/thumb",
    "assets/config.jsonc",
    "DESIGN.md"
  ],
  "scripts": {
    "start": "node bin/pi-pet.cjs start",
    "serve": "node bin/pi-pet.cjs serve",
    "status": "node bin/pi-pet.cjs status",
    "doctor": "node bin/pi-pet.cjs doctor",
"test": "node scripts/check-assets.cjs && node scripts/check-workflow.cjs && node test/smoke.mjs && node test/dsh.mjs && node test/opencode.mjs",
    "test:opencode": "node test/opencode.mjs",
    "test:workflow": "node scripts/check-workflow.cjs",
    "prebuild": "node scripts/stamp.cjs",
    "build": "node scripts/build.cjs --win --publish never --config electron-builder.yml",
    "prebuild:dir": "node scripts/stamp.cjs",
    "build:dir": "node scripts/build.cjs --win --dir --publish never --config electron-builder.yml",

"gen:anim": "node scripts/gen-anim.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "pi": {
    "extensions": [
      "./pi/extensions"
    ]
  }
}
