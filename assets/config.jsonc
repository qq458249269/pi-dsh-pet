      "加油": ["一起加油！", "你在，我也在", "冲！我给你喊"],
      "摸摸": ["嘿嘿…痒", "再摸一下下", "头发会乱的啦", "舒服…眯一会儿"],
      "抱": ["张开手臂了", "抱一下，就一下", "扑过来了，接住"],
      "困": ["那你去睡，我守着", "打哈欠…一起？", "我先眯，你看着"],
      "累": ["歇会儿，不丢人", "要不站起来晃两下"],
      "吃": ["想吃什么？我看着锅", "先说好，我不挑食", "给我留一口"],
      "饿": ["我也是，肚子在叫了", "再忍忍，马上就好"],
      "无聊": ["那就一起发呆吧", "我也无聊，戳我玩嘛", "要不要数羊"],
      "名字": ["叫我小鲸就好", "名字？我想想…就小鲸吧", "他们给我起名都没问我"],
      "谁": ["我是住在你桌角的那只", "窗里那只，就是我"],
      "工作": ["工作再重要也要喝水", "我在旁边盯着进度", "今天也是搬砖的一天"],
      "上班": ["加油，别迟到", "摸鱼被我看见了哦"],
      "下班": ["走啦？路上慢点", "记得下班，不是忘记"],
      "bug": ["报给我，我看看", "又是什么幺蛾子", "先别急，一起看"],
      "报错": ["它说什么了？", "读一遍，我陪你找"],
      "测试": ["全过了吗？我押全过", "又红了一片？"],
      "git": ["提交了吗", "我在这儿 commit，你放心"],
      "push": ["推上去了，我看见了", "推到天上去"],
      "ping": ["我很稳定，不掉线", "延迟？我没感觉到"],
      "内存": ["够用，放心", "我占得不多，随便用"],
      "窗口": ["拖哪儿都行，我跟着", "别把我拖到屏幕外面"],
      "鼠标": ["它是不是坏了", "别老戳我啦"],
      "键盘": ["轻点，我怕痒", "别敲太猛"],
      "主题": ["深色挺护眼的", "换谁都一样好看"],
      "夜晚": ["夜里安静，适合睡觉", "夜猫子？我陪你"],
      "月亮": ["今晚的月亮挺圆", "月亮也打卡下班了"],
      "？": ["我在听", "继续", "嗯……然后呢"],
      "?": ["我在听", "继续", "嗯……然后呢"]
    }
  }
}
