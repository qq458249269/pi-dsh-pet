// dsh-pet 配置（JSONC：允许 // 和 /* */ 注释）
// 说明：浏览器端启动时通过 /pet/config.jsonc 拉取；任何字段缺失/写错都会
//       回退到 client.js 的代码默认值，不会导致插件崩溃。
{
  // ===================== 默认宠物列表（多开） =====================
  // pets 数组定义默认宠物；「设置页 → 添加宠物」的默认模板取 pets[0]（main）。
// 每个宠物独立：id（标识）、size（宽度 px，高度自动 = size × 9/16）、
  // position（corner: 四角之一；marginX/marginY: 距所属角落偏移 px）
  // ⚠️ **横向一律居中**（§9.26）：舞台（窗）宽 = 动画宽 + 两侧余量 + 漫游行程，
  //    贴一侧摆位会让另一侧空出一整块透明窗（实测窗 822 时空 336px），所以 corner 的
  //    *-left / *-right 两支不再决定窗内位置；**纵向**还看 corner（top-* 贴上、bottom-* 贴下），
  //    marginY 是脚下/头顶的偏移。多开时按顺序在舞台里等距错开（不会都挤在正中间）。
  // ⚠️ size 有硬下限 **380**：再窄动画就展示不全（角色两侧被切）。
  //    写小了不会报错，会被抬到 380（见 pi/assets/pet.js 的 MIN_PET_SIZE）。
  // ⚠️⚠️ size 是**舞台宽**（整块 16:9 动画画布），**不等于角色宽**（§9.27）：
  //    素材的画布里角色只占中间 37.5%，左右各有 31.25% 是透明区。
  //    所以 size 462 时角色实际只有 ~173px 宽，贴边/居中/漫游行程都按这个**可见宽**算
  //    （否则左右永远差一百多像素贴不到边）。想「角色有多宽」就拿 size × 0.375。
  // 想「设高度、宽度自适应」就改写 **height**（可选，§9.24）：给了高度，宽度按 16:9 自己算；
  //    下限 214 高（= 380 宽）。高度是屏幕上的真实口径 —— 显不显得下看的是高，不是宽。
  "pets": [
    {
      "id": "main",
      "size": 462,
      "position": {
        "corner": "top-right",
        "marginX": 24,
        "marginY": 100
      }
    }
  ],

  // ===================== 动作动画池配置 =====================
  "animations": {
    // 待机动画池（数组，可放多个，等概率抽）
"idle": ["待机呼吸休闲"],
    // 转向动画池（数组；每一项都必须是“播完会翻转朝向”的动画，如东张西望）
    "turn": ["东张西望"],
    // 拖拽动画池（数组；每一项都必须是“被无形抓起悬空”的姿势）
    "drag": ["被鼠标拖拽悬空反馈"],
    // 点击回应动画池（点按宠物时触发，随机抽 1 个）
    "clicks": [
      "点击回应-开心跃动",
      "点击回应-害羞惊讶",
      "点击回应-傲娇生气",
      "点击回应-挠痒咯咯笑",
      "点击回应-元气挥手"
    ],
    // 鼠标悬停动画池（可选，不写就不播；每次移入随机抽 1 个，移出即回待机）
    "hover": ["点击回应-元气挥手"],
    // 移动动画池：default 是每个动作都用的默认参数；actions 里每项可覆盖部分参数，
    // 未写的字段取 default。minDist/maxDist=单次行进距离(px)、margin=贴边安全距、
    // leadSec/tailSec=动画首尾各多少秒原地不动。
    "moves": {
      "default": { "minDist": 60, "maxDist": 240, "margin": 20, "leadSec": 2, "tailSec": 2 },
      // 漫游（走路自主位移）已关闭：actions 留空 = 宠物位置固定，不再自己往左/右漂。
      // 要恢复就把下面三行取消注释。
      "actions": []
      // "actions": [
      //   { "name": "螃蟹走路" },
      //   { "name": "原地漂浮踏步", "params": { "minDist": 40, "maxDist": 120 } },
      //   { "name": "原地左转奔跑", "params": { "minDist": 120, "maxDist": 320 } }
      // ]
    },
    // 随机动作：分类池。weight 为该分类出现权重；noMirror: true 表示“带文字、镜像会颠倒，
    // 宠物面向右（被镜像）时不播放该类”。所有分类 weight 合计应与 animationWeights 里
    // 顶层权重和的余量（100 − idle − turn − move）相等。
    "categories": [
      { "id": "小动作", "weight": 20, "actions": [
        "悠闲哼歌", "超大伸懒腰", "原地敲击桌面互动", "原地重力下蹲压缩", "哈欠连天",
        "原地小憩沉眠", "女仆屈膝礼仪", "被吓一跳", "小幅度原地360度旋转展示",
        "偷吃零食被抓住", "用鲸鱼尾巴拍打地面", "打瞌睡被惊醒", "照镜子", "整体换装试色",
"轻快记录", "写代码", "摇扇纳凉", "晨间刷牙", "夜晚躺在床上睡觉", "睡床做梦"
      ] },
      { "id": "玩耍", "weight": 20, "actions": [
        "原地专心玩魔方", "原地蹲下玩玩具汽车", "鲸鱼吐泡泡特效", "原地跳跃抓碎头顶物品",
        "玩游戏气急败坏", "玩水枪", "小提琴演奏", "蓝鲸现世", "优雅女仆舞", "轻快摇摆舞",
        "可爱宅舞", "吹气球", "动物环绕", "放风筝", "拆礼物", "变鸽子", "扑克魔术",
        "抽陀螺", "吹笛子", "蝴蝶蜜蜂环绕头顶开花", "撸猫", "凭空生花", "骑木马",
        "三球抛接", "踢毽子", "下五子棋", "荡秋千"
      ] },
      { "id": "吃什么", "weight": 16, "actions": [
        "吃白饭", "大口吃零食", "吃Token", "吃早餐", "吃午餐", "吃晚餐", "吃冰淇淋融化",
        "吃大闸蟹", "吃糖葫芦", "吃长寿面", "吃西瓜", "涮火锅"
      ] },
      { "id": "时节", "weight": 14, "actions": [
        "被落叶淹没", "中秋赏月吃月饼", "堆雪人", "放烟花", "吃粽子", "吃年糕", "吃青团",
        "吃腊八粥", "吃重阳糕", "收红包", "写福字", "穿针乞巧", "舞狮头", "讨糖南瓜灯",
        "插茱萸赏菊", "放河灯", "萌化小幽灵", "装点圣诞树", "放孔明灯", "吃汤圆", "吃饺子"
      ] },
      { "id": "文字", "weight": 10, "noMirror": true, "actions": [
        "是啊，吃什么", "深度思考碎碎念"
      ] }
    ]
  },

  // ===================== 动画链顶层权重 =====================
  // idle/turn/move 的权重 + 上面各分类 weight 合计 = 100
  // 当前：10 + 5 + 5 + (20+20+16+14+10=80) = 100
  //
  // ⚠️ 这三个权重是「一段动画**放完之后**抽下一个」的分布，不是「待机时长」。
  // action 占 80，所以单靠它待机是撑不住的：一段待机呼吸刚结束就有 90% 概率
  // 直接跳去演随机动作，屏幕上的宠物看起来一直忙个不停。靠下面 timing.idleDwellMs
  // 把待机拉长。
  "animationWeights": {
    "idle": 10,
    "turn": 5,
    "move": 5
  },

  // ===================== 节奏（可删，删了就用这里的值）=====================
  // 整段可以不写（老配置照样跑），写错/写负数也自动回落到下面注释里的默认值。
  "timing": {
    // 一段动画**最少**播多久才允许被别人切走（毫秒）。
    // 治「动画没执行完就跳下一个」：鼠标扫过宠物（hover 移出回待机）、拖拽落点回待机、
    // 待机链重抽，这些**被动**切换不再从中间砍掉正在演的那段。
    // 调 0 = 回到老行为（来就切）。用户自己点/拖、状态帧 override 永远立刻生效，不受它管。
    // ⚠️ 默认 2600 + 5000 = **7600**：用户要求每段动画的播放时间统一延长 5 秒。
    "minPlayMs": 7600,

    // 待机动画放完之后，原地续播多久再由链子抽下一个（毫秒）。
    // 治「待机时间太短」：默认 6s，加上待机片本身的时长 = 每轮待机约 10s+。
    // 期间鼠标点一下 / 拖一下 / 来了状态帧，立刻收摊去干别的。
    // 调 0 = 不停留（旧行为）。
// ⚠️ 默认 6000 + 5000 = **11000**（同上一条：播放时间统一延长 5 秒）。
"idleDwellMs": 11000
  },

  // ===================== 聊天 & 碎碎念（§9.30）=====================
  // 整段可以不写（老配置照样跑，只是不会碎碎念）；写错了也自动当没写，不影响宠物。
  //   · 双击宠物（或右键菜单「说点什么…」）→ 头顶弹输入框 → 回车 → 它按关键词回一句
  //   · 闲着没人理它（agent 不忙、没人在打字）时，随机挑个时刻自己冒一句废话
  // fallback 是关键词一个都没命中时的回话；replies 的键是关键词（子串匹配，取最长命中）。
  // ===================== 手势气泡（§9.37）=====================
  // 鼠标移入 / 点一下 / 拖起来 / 放下，各冒一句（随机抽，同类之间有冷却）。
  // 整段可以不写 = 不出声；agent 正在忙 / 有人在打字时一律闭嘴（同碎碎念）。
  // cooldownMs：同一类手势两次冒泡的最小间隔（毫秒），免得鼠标扫来扫去刷屏。
  "gestures": {
    "cooldownMs": 6000,
    "hover": [
      "哎，你来啦",
      "看你呢",
      "戳我?",
      "我在这儿呢",
      "手冷不冷",
      "别光看我，看屏幕",
      "在忙?",
      "要不要摸摸头",
      "我一直醒着"
    ],
    "click": [
      "诶?",
      "干嘛呀",
      "再点我就化了",
      "好吧好吧",
      "痒",
      "这一下挺准",
      "手别抖",
      "收到了",
      "再来一次?",
      "嗯?"
    ],
    "drag": [
      "轻点轻点",
      "别拎我领子",
      "哎哟——",
      "要飞起来了",
      "我鞋掉了",
      "慢一点，我头晕",
      "别甩我",
"抓稳了没?",
      "我尾巴要散了",
"抰我作甚（《诗经·卷耳》）",
      "欲济无舟楫（《诗经·小雅》）",
      "载驰载驱（《诗经·鄘风》）",
      "幽幽苍天（《诗经·大雅》）",
      "民亦劳止，汔可小康（《诗经·大雅》）",
      "天将降大任于是人（先稳住我）",
      "上天梯，莫登我（晃得太晕）",
      "勿以恶小而为之（手别抖）"
    ],
    "drop": [
      "就这儿吧",
      "放下就放下",
      "别再搬我了",
      "这儿视野好",
      "脚有点麻",
      "安顿了",
      "谢谢",
      "别推来推去",
"落地成盒",
      "记这儿了",
      "于嗟鸠兮，无食桑葚（《诗经·魏风》）",
      "溥天之下，莫非王土（《诗经·小雅》）",
      "考槃在洞，硕人之邈（《诗经·卫风》）",
      "此心安处是吾乡",
      "地势坤，君子以厚德载物",
      "落地即稳，不走了"
    ]
  },
  "chatter": {
    "enabled": false,
    "idleSec": [90, 180],
    "idle": [
      "……",
      "好无聊呀",
      "戳我一下嘛",
      "你还在忙啊",
      "要不…先歇会儿？",
      "我先蹲着，不吵你",
      "饿了…能吃点什么吗",
      "刚才是不是有人在敲我",
      "别急，我盯着呢",
      "需要我背锅吗",
      "水凉了",
      "要不要摸摸头",
      "我数了数，你今天看了我 3 次",
      "再不动就要生锈了",
"这个 bug 有点意思",
      "无事可做，气泡都凉了",
      "我在思考人生…人生在想什么",
      "无所事事的一天",
      "要不我们聊两句",
      "别不理我呀",
      "地板凉，屁股也凉",
      "窗外的云走了很久",
      "今天第 17 次看钟了",
