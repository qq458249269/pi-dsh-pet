# ── 素材处理链中间产物（跑 scripts/*.py 可再生，不入仓库） ──
step01/
step02/
step03/
step04/

# ── 素材源（托管在 GitHub Releases assets-videos，不入仓库） ──
video/*.mp4

# ── PR 手工抠像工作数据（本地工作数据，同 step 中间产物，不入库） ──
#   pr/      PR 导出的透明 .mov（路线 B 的输入）
#   prproj/  PR 工程目录（.prproj + 遮罩缓存 + 自动保存，约 2GB）
pr/
prproj/

# ── 本地工具（机器相关，不入仓库） ──
.tools/

# ── Python ──
__pycache__/
*.py[cod]
.venv/
.uv-cache/

# ── Node ──
node_modules/
.npm-cache/
npm-debug.log*
*.tgz
dist/

# electron-builder 的构建资源目录（图标等；空目录，electron-builder 用默认图标）
build/

# CI 生成的打包配置（extends 本地配置 + 钉住的 electron 版本；每次跑都不一样）
electron-builder.ci.json

# ── 临时/备份目录 ──
temp/

# scripts/slim-assets.cjs 压素材时留的原件备份（npm run assets:restore 靠它还原）
assets/thumb.orig/

# ── IDE / 编辑器 ──
.idea/
.vscode/
*.swp

# ── 系统文件 ──
.DS_Store
Thumbs.db
desktop.ini

# ── 环境变量 ──
.env
.env.local
.env.production
*.log

# ── Windows 保留设备名（Git 无法索引）──
nul

# ── 本地临时（调试脚本 / 临时数据目录）──
.tmp/
# 量桌面宠物的探针现场（量气泡 bbox / 跟手比例的脚本 + 截图，几 MB，可再生）
tmp/
